{
  "name": "svt-project-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cookbook": "npm run typecheck && esbuild eng/build-cookbook.tsx --bundle --platform=node --format=esm --packages=external --outfile=.local/build-cookbook.mjs && node .local/build-cookbook.mjs",
    "preview:cookbook": "esbuild --serve=127.0.0.1:8788 --servedir=.local/site",
    "build:pages": "tsc -p tsconfig.pages.json && esbuild eng/build-pages.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/build-pages.mjs && node .local/build-pages.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p cookbook/tsconfig.worker.json",
    "test:cookbook": "npm run build:cookbook && node --test eng/prepare-source.test.ts eng/cookbook.browser.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.0",
    "@lezer/common": "1.5.7",
    "@lezer/highlight": "1.2.5",
    "@lezer/xml": "1.0.6",
    "@svt-project/svt-js": "1.0.0-rc.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0"
  }
}
